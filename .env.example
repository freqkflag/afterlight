# Afterlight Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://afterlight:afterlight@localhost:5432/afterlight

# Security
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=base64-encoded-32-byte-key-generate-with-openssl-rand-base64-32

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Dead Man's Switch
DEFAULT_CHECK_IN_INTERVAL_DAYS=30
DEFAULT_GRACE_PERIOD_DAYS=14

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@afterlight.io
SMTP_USE_TLS=true

# App
APP_NAME=Afterlight
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
